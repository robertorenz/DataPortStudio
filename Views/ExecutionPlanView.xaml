<UserControl x:Class="DataPortStudio.Views.ExecutionPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DataPortStudio.Services"
             Background="{DynamicResource B.Surface}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Amber" Color="#FFE0912B"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary + actions -->
        <Border Grid.Row="0" Background="{DynamicResource B.SurfaceAlt}" BorderBrush="{DynamicResource B.Border}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Tr PL_ExpandAll}" Padding="10,3" Click="ExpandAll_Click"/>
                    <Button Content="{loc:Tr PL_CollapseAll}" Padding="10,3" Margin="6,0,0,0" Click="CollapseAll_Click"/>
                    <Button Content="{loc:Tr PL_CopyRaw}" Padding="10,3" Margin="6,0,0,0" Click="CopyRaw_Click"/>
                    <Button x:Name="SaveButton" Content="{loc:Tr PL_SaveRaw}" Padding="10,3" Margin="6,0,0,0" Click="SaveRaw_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource B.Text}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border x:Name="WarningChip" Background="{StaticResource Amber}" CornerRadius="9" Padding="8,1"
                            Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="WarningChipText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{loc:Tr PL_NotExecuted}" Foreground="{DynamicResource B.TextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Missing-index suggestions -->
        <Border x:Name="SuggestionPanel" Grid.Row="1" Visibility="Collapsed" Margin="12,10,12,0"
                BorderBrush="{StaticResource Amber}" BorderThickness="3,1,1,1" CornerRadius="4"
                Background="{DynamicResource B.Surface}" Padding="10,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="{loc:Tr PL_CopySuggestions}" Padding="10,2"
                            Click="CopySuggestions_Click"/>
                    <TextBlock Text="{loc:Tr PL_SuggestionsTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource B.Text}"/>
                </DockPanel>
                <TextBox x:Name="SuggestionBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="{DynamicResource B.SurfaceAlt}" Foreground="{DynamicResource B.Text}" Padding="6"/>
            </DockPanel>
        </Border>

        <!-- Plan tree + details -->
        <Grid Grid.Row="2" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="320" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource B.GridHeader}"
                            BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr PL_ColStep}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource B.Text}"/>
                            <TextBlock Grid.Column="1" Text="{loc:Tr PL_ColRows}" FontWeight="SemiBold" FontSize="12"
                                       TextAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource B.Text}"/>
                            <TextBlock x:Name="ShareHeader" Grid.Column="2" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource B.Text}"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="StepList" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" SelectionChanged="StepList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                        <TextBlock Text="{Binding Glyph}" Width="16" Cursor="Hand" FontSize="11"
                                                   Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center"
                                                   MouseLeftButtonDown="Glyph_MouseDown"/>
                                        <TextBlock Text="⚠" Foreground="{StaticResource Amber}" Margin="0,0,5,0"
                                                   VerticalAlignment="Center" FontWeight="Bold"
                                                   Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="{Binding WarningText}"/>
                                        <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource B.Text}"/>
                                        <TextBlock Text="{Binding Object}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource B.TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RowsText}" TextAlignment="Right"
                                               Margin="0,0,12,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource B.Text}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="100" Height="8" CornerRadius="4" Background="{DynamicResource B.SurfaceAlt}"
                                                BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                                Visibility="{Binding HasShare, Converter={StaticResource BoolToVis}}">
                                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHot}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource B.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding PercentText}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHot}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource B.Danger}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource B.Surface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DetailPanel" Margin="12,10"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
