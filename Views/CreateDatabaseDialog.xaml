<Window x:Class="DataPortStudio.Views.CreateDatabaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DataPortStudio.Services"
        Title="{loc:Tr DbCreate_Title}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False" Width="480">
    <Border Background="{DynamicResource B.Surface}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.25" Color="#FF1F2933"/>
        </Border.Effect>
        <StackPanel>
            <Border Background="{DynamicResource B.Sidebar}" CornerRadius="12,12,0,0"
                    Padding="20,16" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,3 H14 V6.5 H2 Z M2,9.5 H14 V13 H2 Z M8,1 V15 M5,8 H11"
                          Width="18" Height="18" Stretch="Uniform" Stroke="#FF2D7FE0"
                          StrokeThickness="1.4" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr DbCreate_Title}" Margin="12,0,0,0"
                               FontSize="16" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="650" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,10">
                <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="8"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,14">
                    <TextBlock x:Name="EngineText" TextWrapping="Wrap"
                               Foreground="{DynamicResource B.TextMuted}"/>
                </Border>

                <Label Content="{loc:Tr DbCreate_Name}" Target="{Binding ElementName=NameBox}"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                <StackPanel x:Name="SqlServerPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="{loc:Tr DbCreate_SqlServerRecovery}"
                                   Target="{Binding ElementName=SqlServerRecoveryBox}"/>
                            <ComboBox x:Name="SqlServerRecoveryBox" SelectedIndex="0">
                                <ComboBoxItem Content="Full" Tag="FULL"/>
                                <ComboBoxItem Content="Simple" Tag="SIMPLE"/>
                                <ComboBoxItem Content="Bulk-logged" Tag="BULK_LOGGED"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{loc:Tr DbCreate_SqlServerCompatibility}"
                                   Target="{Binding ElementName=SqlServerCompatibilityBox}"/>
                            <ComboBox x:Name="SqlServerCompatibilityBox"/>
                        </StackPanel>
                    </Grid>

                    <Label Content="{loc:Tr DbCreate_SqlServerCollation}"
                           Target="{Binding ElementName=SqlServerCollationBox}"/>
                    <TextBox x:Name="SqlServerCollationBox" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Tr DbCreate_SqlServerHint}" TextWrapping="Wrap"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,14"/>

                    <TextBlock Text="{loc:Tr DbCreate_SqlServerFiles}" FontSize="14"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Tr DbCreate_SqlServerDataFile}" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="{loc:Tr DbCreate_LogicalName}"
                                   Target="{Binding ElementName=SqlDataLogicalNameBox}"/>
                            <TextBox x:Name="SqlDataLogicalNameBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{loc:Tr DbCreate_PhysicalPath}"
                                   Target="{Binding ElementName=SqlDataPathBox}"/>
                            <TextBox x:Name="SqlDataPathBox" HorizontalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="{loc:Tr DbCreate_InitialSizeMb}"
                                   Target="{Binding ElementName=SqlDataSizeBox}"/>
                            <TextBox x:Name="SqlDataSizeBox" Text="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{loc:Tr DbCreate_MaxSizeMb}"
                                   Target="{Binding ElementName=SqlDataMaxSizeBox}"/>
                            <TextBox x:Name="SqlDataMaxSizeBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="{loc:Tr DbCreate_GrowthMb}"
                                   Target="{Binding ElementName=SqlDataGrowthBox}"/>
                            <TextBox x:Name="SqlDataGrowthBox" Text="64"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Tr DbCreate_SqlServerLogFile}" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="{loc:Tr DbCreate_LogicalName}"
                                   Target="{Binding ElementName=SqlLogLogicalNameBox}"/>
                            <TextBox x:Name="SqlLogLogicalNameBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{loc:Tr DbCreate_PhysicalPath}"
                                   Target="{Binding ElementName=SqlLogPathBox}"/>
                            <TextBox x:Name="SqlLogPathBox" HorizontalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="{loc:Tr DbCreate_InitialSizeMb}"
                                   Target="{Binding ElementName=SqlLogSizeBox}"/>
                            <TextBox x:Name="SqlLogSizeBox" Text="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{loc:Tr DbCreate_MaxSizeMb}"
                                   Target="{Binding ElementName=SqlLogMaxSizeBox}"/>
                            <TextBox x:Name="SqlLogMaxSizeBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="{loc:Tr DbCreate_GrowthMb}"
                                   Target="{Binding ElementName=SqlLogGrowthBox}"/>
                            <TextBox x:Name="SqlLogGrowthBox" Text="64"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Tr DbCreate_MaxSizeHint}" TextWrapping="Wrap"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SqlServerDefaultsStatus" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource B.TextMuted}"/>
                </StackPanel>

                <StackPanel x:Name="PostgresPanel" Visibility="Collapsed">
                    <Label Content="{loc:Tr DbCreate_PostgresOwner}"
                           Target="{Binding ElementName=PostgresOwnerBox}"/>
                    <TextBox x:Name="PostgresOwnerBox" Margin="0,0,0,14"/>
                    <Label Content="{loc:Tr DbCreate_PostgresEncoding}"
                           Target="{Binding ElementName=PostgresEncodingBox}"/>
                    <ComboBox x:Name="PostgresEncodingBox" SelectedIndex="0">
                        <ComboBoxItem Content="UTF8"/>
                        <ComboBoxItem Content="LATIN1"/>
                        <ComboBoxItem Content="SQL_ASCII"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="MySqlPanel" Visibility="Collapsed">
                    <Label Content="{loc:Tr DbCreate_MySqlCharset}"
                           Target="{Binding ElementName=MySqlCharsetBox}"/>
                    <ComboBox x:Name="MySqlCharsetBox" IsEditable="True" Text="utf8mb4"
                              Margin="0,0,0,14">
                        <ComboBoxItem Content="utf8mb4"/>
                        <ComboBoxItem Content="utf8"/>
                        <ComboBoxItem Content="latin1"/>
                    </ComboBox>
                    <Label Content="{loc:Tr DbCreate_MySqlCollation}"
                           Target="{Binding ElementName=MySqlCollationBox}"/>
                    <TextBox x:Name="MySqlCollationBox"/>
                </StackPanel>

                <StackPanel x:Name="MongoPanel" Visibility="Collapsed">
                    <Label Content="{loc:Tr DbCreate_MongoCollection}"
                           Target="{Binding ElementName=MongoCollectionBox}"/>
                    <TextBox x:Name="MongoCollectionBox" Text="items" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Tr DbCreate_MongoHint}" TextWrapping="Wrap"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource B.TextMuted}"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0"
                    Padding="16,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr Btn_Cancel}" MinWidth="90" Margin="0,0,10,0"
                            Click="Cancel_Click" IsCancel="True"/>
                    <Button x:Name="CreateButton" Content="{loc:Tr DbCreate_Create}" MinWidth="90"
                            Style="{StaticResource AccentButton}" Click="Create_Click"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
