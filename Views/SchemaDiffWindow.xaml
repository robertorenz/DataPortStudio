<Window x:Class="DataPortStudio.Views.SchemaDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schema Diff" Height="720" Width="1050" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Independent source/target endpoints -->
        <Border Grid.Row="0" Background="{DynamicResource B.HeaderBar}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="LEFT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,5"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LeftConnectionCombo" DisplayMemberPath="Label"
                                  SelectionChanged="LeftConnection_Changed"/>
                        <ComboBox x:Name="LeftDbCombo" Grid.Column="2"
                                  SelectionChanged="LeftDatabase_Changed"/>
                        <ComboBox x:Name="LeftSchemaCombo" Grid.Column="4"
                                  SelectionChanged="Endpoint_Changed"/>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="↔" FontSize="21"
                           VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,3"/>

                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RIGHT" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,5"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RightConnectionCombo" DisplayMemberPath="Label"
                                  SelectionChanged="RightConnection_Changed"/>
                        <ComboBox x:Name="RightDbCombo" Grid.Column="2"
                                  SelectionChanged="RightDatabase_Changed"/>
                        <ComboBox x:Name="RightSchemaCombo" Grid.Column="4"
                                  SelectionChanged="Endpoint_Changed"/>
                    </Grid>
                </Grid>

                <Button Grid.Row="0" Grid.Column="3" x:Name="CompareButton" Content="Compare"
                        Style="{StaticResource AccentButton}" Margin="20,19,0,0"
                        VerticalAlignment="Top" Click="Compare_Click" IsEnabled="False"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Objects:" Foreground="{DynamicResource B.TextMuted}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox x:Name="TablesCheck" Content="Tables" IsChecked="True"
                              VerticalAlignment="Center"/>
                    <CheckBox x:Name="ViewsCheck" Content="Views" IsChecked="True"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <CheckBox x:Name="FunctionsCheck" Content="Functions" IsChecked="True"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <CheckBox x:Name="ProceduresCheck" Content="Procedures" IsChecked="True"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Border Width="1" Height="18" Background="{DynamicResource B.Border}"
                            Margin="18,0"/>
                    <CheckBox x:Name="RespectOrderCheck" Content="Respect column order"
                              IsChecked="True" VerticalAlignment="Center"/>
                    <TextBlock Text="Column positions count as table changes."
                               Foreground="{DynamicResource B.TextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ResultsPanel" Margin="16,8"/>
        </ScrollViewer>

        <!-- Safe deployment actions: only tables absent at the destination are eligible. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0"
                Background="{DynamicResource B.HeaderBar}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SelectAllCheck" Content="Select transferable objects" IsEnabled="False"
                          IsThreeState="True"
                          VerticalAlignment="Center" Click="SelectAll_Click"/>
                <CheckBox x:Name="IncludeDataCheck" Grid.Column="1" Content="Include data"
                          VerticalAlignment="Center" Margin="22,0,0,0"/>
                <TextBlock Grid.Column="2" Text="Changed routines/views replace definitions; supported table columns use transactional ALTER TABLE."
                           Foreground="{DynamicResource B.TextMuted}" FontSize="11"
                           VerticalAlignment="Center" Margin="18,0,12,0"/>
                <Button Grid.Column="3" x:Name="CopyRightToLeftButton" Content="← Apply selected"
                        Margin="0,0,8,0" Padding="14,6" IsEnabled="False"
                        Click="CopyRightToLeft_Click"/>
                <Button Grid.Column="4" x:Name="CopyLeftToRightButton" Content="Apply selected →"
                        Style="{StaticResource AccentButton}" IsEnabled="False"
                        Click="CopyLeftToRight_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource B.Sidebar}" Padding="16,6">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource B.SidebarText}" FontSize="12"
                       Text="Select the two endpoints and click Compare."/>
        </Border>
    </Grid>
</Window>
