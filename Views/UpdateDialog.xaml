<Window x:Class="DataPortStudio.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DataPortStudio.Services"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height"
        ShowInTaskbar="False" Width="560">
    <Border Background="{DynamicResource B.Surface}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.25" Color="#FF1F2933"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header (draggable) -->
            <Border CornerRadius="12,12,0,0" Padding="20,16" Background="Transparent"
                    MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="#FF2E9E5B" VerticalAlignment="Center">
                        <TextBlock Text="↓" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource B.TextMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Release notes -->
            <TextBlock Text="{loc:Tr Update_WhatsNew}" Margin="20,0,20,6" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.TextMuted}"/>
            <TextBox x:Name="NotesBox" Margin="20,0,20,16" Height="240" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8"
                     FontSize="12.5" BorderThickness="1"
                     Background="{DynamicResource B.SurfaceAlt}" Foreground="{DynamicResource B.Text}"
                     BorderBrush="{DynamicResource B.Border}"/>

            <!-- Download progress -->
            <StackPanel x:Name="ProgressPanel" Margin="20,0,20,16" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource B.TextMuted}"/>
                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1"
                             Foreground="{DynamicResource B.Accent}" Background="{DynamicResource B.SurfaceAlt}"
                             BorderBrush="{DynamicResource B.Border}"/>
            </StackPanel>

            <!-- Buttons -->
            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="0,0,12,12"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Padding="16,14">
                <DockPanel LastChildFill="False">
                    <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="{loc:Tr Update_Skip}"
                            MinWidth="90" Click="Skip_Click"/>
                    <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="{loc:Tr Update_Install}"
                            MinWidth="140" Style="{StaticResource AccentButton}" IsDefault="True" Click="Install_Click"/>
                    <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="{loc:Tr Update_Later}"
                            MinWidth="90" Margin="0,0,10,0" IsCancel="True" Click="Later_Click"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
