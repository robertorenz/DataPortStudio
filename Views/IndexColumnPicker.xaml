<UserControl x:Class="DataPortStudio.Views.IndexColumnPicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="38" VerticalAlignment="Center">
    <Border Background="{DynamicResource B.SurfaceAlt}"
            BorderBrush="{DynamicResource B.BorderStrong}"
            BorderThickness="1" CornerRadius="5" Padding="4,3">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Right" Width="150" Margin="6,0,0,0">
                <ComboBox x:Name="ColumnPicker"
                          ItemsSource="{Binding Choices, ElementName=Root}"
                          SelectionChanged="ColumnPicker_SelectionChanged"
                          DropDownOpened="ColumnPicker_DropDownOpened"
                          VerticalContentAlignment="Center"/>
                <TextBlock Text="Select column…" Margin="9,0,25,0"
                           Foreground="{DynamicResource B.TextMuted}"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding SelectedItem, ElementName=ColumnPicker, Converter={StaticResource NullToVis}}"/>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Tokens, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource B.RowSelected}"
                                    BorderBrush="{DynamicResource B.Accent}"
                                    BorderThickness="1" CornerRadius="5"
                                    Margin="0,0,5,0" Padding="7,2,2,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource B.Text}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="×" Tag="{Binding}" Click="RemoveToken_Click"
                                            ToolTip="Remove column" Margin="4,0,0,0"
                                            Padding="4,0" MinWidth="20" Height="22"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource B.TextMuted}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
